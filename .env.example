# Copie para .env (ignorado pelo git) e preencha. Nunca commite o .env.
# Os testes de integração (`npm run test:integration`) leem estas variáveis do env ou deste arquivo
# e PULAM a bateria correspondente quando a credencial não está definida.

# ---------- Ambiente uMov.me ----------
# Nome do ambiente (domínio) — o mesmo usado no login do Center e em UmovClient.fromCredentials({ domain })
UMOV_DOMAIN=seu-ambiente

# ---------- API v1 (CenterWeb / XML) ----------
# Token da API v1: Center → Configurações → Integração → Token da API (regenerar invalida o anterior)
UMOV_API_KEY=
# Opcional: login/senha do Center para obter o token via POST /token.xml (UmovClient.fromCredentials)
UMOV_LOGIN=
UMOV_PASSWORD=

# ---------- API 2.0 (JSON, headers AppId/AppKey) ----------
# Os dois são fornecidos pelo suporte da uMov.me (ainda não há gestão na interface do Center).
# AppId: inteiro único por ambiente (ex.: 2). Não é segredo, mas obrigatório em todo request.
UMOV_APP_ID=
# AppKey: token da API 2.0 (formato UUID). Sem endpoint de renovação — expiração/criação é via suporte.
UMOV_APP_KEY=
